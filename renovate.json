{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "kubernetes",
    "dockerfile",
    "helm-values",
    "argocd",
    "custom.regex"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+/deployment\\.yaml$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/apps/.+/Dockerfile$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/apps/.+/values\\.yaml$/",
      "/apps/.+/helmrelease\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "^apps/.+\\.yaml$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps/system-upgrade/.+\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "automerge": false
    }
  ]
}