{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "kubernetes",
    "dockerfile",
    "helm-values",
    "argocd",
    "custom.regex"
  ],
  "helm-values": {
    "fileMatch": [
      "(^|/)values\\.yaml$",
      "(^|/)helmrelease\\.yaml$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)system-upgrade/.+\\.yaml$"
      ],
      "matchStrings": [
        "version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "automerge": false
    }
  ]
}